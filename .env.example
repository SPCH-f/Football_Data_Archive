# ============================================================
# Football RAG Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ──────────────────────────────────────────────
# Options: "openai" | "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Football APIs ─────────────────────────────────────────────
# football-data.org (10 req/min)
FOOTBALL_DATA_API_KEY=your_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# API-Football / api-sports.io (100 req/day)
API_FOOTBALL_KEY=your_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=football_rag
POSTGRES_PASSWORD=changeme_strong_password_123
POSTGRES_DB=football_rag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ── pgAdmin ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@footballrag.local
PGADMIN_DEFAULT_PASSWORD=admin123

# ── Backend ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=info

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Football RAG Chatbot

# ── Scheduler ────────────────────────────────────────────────
SYNC_FIXTURES_INTERVAL_HOURS=6
SYNC_STANDINGS_INTERVAL_HOURS=24
H2H_CACHE_TTL_DAYS=7

# ── Cache TTLs (seconds) ─────────────────────────────────────
CACHE_TTL_FIXTURES=3600
CACHE_TTL_STANDINGS=86400
CACHE_TTL_TEAM_FORM=3600
CACHE_TTL_H2H=604800

# ── RAG Settings ─────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75
RAG_USE_MMR=true
RAG_MMR_DIVERSITY=0.3
CHAT_MEMORY_LENGTH=6

# ── Admin ────────────────────────────────────────────────────
ADMIN_API_KEY=changeme_admin_secret_key

# ── Competitions to track (comma-separated codes) ────────────
# PL=Premier League, PD=La Liga, BL1=Bundesliga, SA=Serie A, FL1=Ligue 1, CL=Champions League
TRACKED_COMPETITIONS=PL,PD,BL1,SA,FL1,CL
